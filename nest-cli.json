{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "root": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "proto/**/*.proto",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
