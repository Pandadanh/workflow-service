# ============================================
# WORKFLOW SERVICE - PRODUCTION ENVIRONMENT
# ============================================

NODE_ENV=production
PORT=8089

DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@prod-db-host:5432/badminton_booking?sslmode=require

JWT_SECRET=CHANGE_TO_VERY_STRONG_RANDOM_SECRET_IN_PRODUCTION

RABBITMQ_URL=amqp://prod_user:STRONG_PASSWORD@prod-rabbitmq-host:5672

REDIS_URL=redis://prod-redis-host:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prod-email@gmail.com
SMTP_PASS=prod-app-password
SMTP_FROM=noreply@badminton-booking.com

GATEWAY_URL=https://gateway.your-domain.com
SERVICE_NAME=workflow
SERVICE_HOST=workflow.your-domain.com
SERVICE_PROTOCOL=https
SERVICE_BASE_URL=https://workflow.your-domain.com
SERVICE_INSTANCE_ID=workflow-prod-1
GATEWAY_HEARTBEAT_INTERVAL=5000
GATEWAY_RETRY_INTERVAL=15000
GATEWAY_REGISTRY_ENABLED=true
