// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model FailedQueueMessage {
  id           String    @id @default(uuid()) @db.Uuid
  queueName    String
  messageType  String
  messageData  Json
  errorMessage String
  errorStack   String?
  retryCount   Int       @default(0)
  lastRetryAt  DateTime?
  failedAt     DateTime  @default(now())
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?   @db.Uuid
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queueName])
  @@index([messageType])
  @@index([isResolved])
  @@index([failedAt])
}


model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  username               String                  @unique
  email                  String?                 @unique
  password               String
  roles                  UserRole[]              @default([user])
  note                   String?
  properties             Json?
  is_active              Boolean                 @default(true)
  is_deleted             Boolean                 @default(false)
  created_at             DateTime                @default(now())
  created_by             String?
  updated_at             DateTime                @default(now())
  updated_by             String?
  notifications          Notification[]
  // Reservation relations
  host_reservations      Reservation[]           @relation("ReservationHost")
  reservations           Reservation[]           @relation("ReservationUser")
  point_transactions     PointTransaction[]
  reported_reports       ReportMatching[]        @relation("ReportedUser")
  reporter_reports       ReportMatching[]        @relation("Reporter")
  requestWithdrawals     RequestWithdrawal[]
  transactions           Transaction[]
  profile                UserProfile?
  user_ranks             UserRank?
  wallet                 UserWallet?
  withdrawalLimit        UserWithdrawalLimit?
  withdrawalOtps         WithdrawalOtp[]
  withdrawalTransactions WithdrawalTransaction[]
  mediaFiles             MediaFile[]
  
  // Tournament module relations
  hosted_tournaments     Tournament[]            @relation("UserHostedTournaments")
  players                Player[]
  
  // report owner relations
  reported_owners        ReportOwner[]           @relation("Reporter")
  owned_reports          ReportOwner[]           @relation("ReportOwnerUser")
  bankAccounts           UserBankAccount[]
  
  // Group relations
  managed_groups         Group[]                 @relation("GroupManager")
  group_members          GroupMember[]           @relation("GroupMemberUser")
  group_posts            GroupPost[]             @relation("GroupPostAuthor")

  // Course relations
  channels               CourseChannel[]         @relation("CoachChannels")
  enrollments            CourseEnrollment[]
  feedbacks              Feedback[]

  // GroupPost relaition
  post_likes             PostLike[]
  post_comments          PostComment[]


  @@index([username])
  @@index([email])
  @@index([roles])
  @@index([created_at])
  @@index([is_active])
  @@index([is_deleted])
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  title        String
  message      String
  type         NotificationType     @default(GENERAL)
  isRead       Boolean              @default(false)
  readAt       DateTime?
  resourceId   String?              @db.Uuid
  resourceType String?
  actionUrl    String?
  metadata     Json?
  note         String?
  properties   Json?
  isActive     Boolean              @default(true)
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    String?              @db.Uuid
  updatedBy    String?              @db.Uuid
  user         User                 @relation(fields: [userId], references: [id])
  details      NotificationDetail[]

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([resourceId])
  @@index([resourceType])
}

model Reservation {
  id              String         @id @default(uuid()) @db.Uuid
  court_id        String         @db.Uuid
  host_id         String         @db.Uuid
  user_id         String         @db.Uuid
  is_active       Boolean        @default(true)
  is_deleted      Boolean        @default(false)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now())
  created_by      String?        @db.Uuid
  updated_by      String?        @db.Uuid
  court           BadmintonCourt @relation(fields: [court_id], references: [id])
  host            User           @relation("ReservationHost", fields: [host_id], references: [id])
  user            User           @relation("ReservationUser", fields: [user_id], references: [id])

  @@index([court_id])
  @@index([host_id])
  @@index([user_id])
  @@index([created_at])
  @@index([is_active])
}


model PointTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  user_id      String            @db.Uuid
  booking_id   String?           @db.Uuid
  point_change Int               @default(10)
  reason       String?
  bonus        Int               @default(0)
  note         String?
  properties   Json?
  is_active    Boolean           @default(true)
  is_deleted   Boolean           @default(false)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @default(now())
  created_by   String?           @db.Uuid
  updated_by   String?           @db.Uuid
  booking      BadmintonBooking? @relation(fields: [booking_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id])

  @@unique([user_id, booking_id])
}

model ReportMatching {
  id                String            @id @default(uuid()) @db.Uuid
  reported_user_id  String            @db.Uuid
  reporter_id       String            @db.Uuid
  reason            String?
  status            String            @default("pending")
  booking_id        String?           @db.Uuid
  note              String?
  properties        Json?
  is_active         Boolean           @default(true)
  is_deleted        Boolean           @default(false)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now())
  created_by        String?           @db.Uuid
  updated_by        String?           @db.Uuid

  reported_user     User              @relation("ReportedUser", fields: [reported_user_id], references: [id])
  reporter          User              @relation("Reporter", fields: [reporter_id], references: [id])
  booking           BadmintonBooking? @relation(fields: [booking_id], references: [id])
}

model RequestWithdrawal {
  id            String                @id @default(uuid()) @db.Uuid
  withdrawalId  String                @db.Uuid
  userId        String                @db.Uuid
  amount        Decimal               @db.Decimal(20, 2)
  method        WithdrawalMethod      @default(MOMO)
  recipientInfo Json
  transactionId String                @unique
  status        RequestStatus         @default(PENDING)
  priority      Int                   @default(1)
  scheduledAt   DateTime              @default(now())
  processedAt   DateTime?
  completedAt   DateTime?
  errorMessage  String?
  retryCount    Int                   @default(0)
  maxRetries    Int                   @default(3)
  nextRetryAt   DateTime?
  metadata      Json?
  isActive      Boolean               @default(true)
  isDeleted     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id])
  withdrawal    WithdrawalTransaction @relation(fields: [withdrawalId], references: [id])

  @@index([withdrawalId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([priority])
  @@index([nextRetryAt])
}

model Transaction {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  access_token  String
  refresh_token String
  expired_at    DateTime?
  ip_address    String?
  user_agent    String?
  note          String?
  properties    Json?
  is_active     Boolean   @default(true)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  created_by    String?
  updated_at    DateTime  @default(now())
  updated_by    String?
  user          User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model UserProfile {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @unique @db.Uuid
  first_name    String?
  last_name     String?
  phone_number  String?
  email         String?   @unique
  date_of_birth DateTime?
  gender        String?
  avatar_url    String?
  bio           String?
  address       String?
  social_links  Json?
  properties    Json?
  is_active     Boolean   @default(true)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  user          User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([phone_number])
}

model UserRank {
  id            String     @id @default(uuid()) @db.Uuid
  user_id       String     @unique @db.Uuid
  current_point Int        @default(0)
  rank_id       String?    @db.Uuid
  note          String?
  properties    Json?
  is_active     Boolean    @default(true)
  is_deleted    Boolean    @default(false)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @default(now())
  created_by    String?    @db.Uuid
  updated_by    String?    @db.Uuid
  rank_level    RankLevel? @relation(fields: [rank_id], references: [id])
  user          User       @relation(fields: [user_id], references: [id])
}

model UserWallet {
  id            String                  @id @default(uuid()) @db.Uuid
  userId        String                  @unique @db.Uuid
  balance       Decimal                 @default(0) @db.Decimal(20, 2)
  frozenBalance Decimal                 @default(0) @db.Decimal(20, 2)
  version       Int                     @default(1)
  lastUpdated   DateTime                @default(now())
  isActive      Boolean                 @default(true)
  isDeleted     Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     String?                 @db.Uuid
  updatedBy     String?                 @db.Uuid
  user          User                    @relation(fields: [userId], references: [id])
  withdrawals   WithdrawalTransaction[]

  @@index([userId])
  @@index([balance])
}

model UserWithdrawalLimit {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  dailyLimit      Decimal  @default(5000000) @db.Decimal(20, 2)
  weeklyLimit     Decimal  @default(20000000) @db.Decimal(20, 2)
  monthlyLimit    Decimal  @default(50000000) @db.Decimal(20, 2)
  maxTransactions Int      @default(10)
  minAmount       Decimal  @default(50000) @db.Decimal(20, 2)
  maxAmount       Decimal  @default(2000000) @db.Decimal(20, 2)
  todayAmount     Decimal  @default(0) @db.Decimal(20, 2)
  todayCount      Int      @default(0)
  weekAmount      Decimal  @default(0) @db.Decimal(20, 2)
  monthAmount     Decimal  @default(0) @db.Decimal(20, 2)
  lastResetDate   DateTime @default(now())
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WithdrawalOtp {
  id           String                @id @default(uuid()) @db.Uuid
  withdrawalId String                @db.Uuid
  userId       String                @db.Uuid
  token        String
  hashedToken  String
  attemptCount Int                   @default(0)
  maxAttempts  Int                   @default(5)
  isUsed       Boolean               @default(false)
  isActive     Boolean               @default(true)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id])
  withdrawal   WithdrawalTransaction @relation(fields: [withdrawalId], references: [id])

  @@index([withdrawalId])
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model WithdrawalTransaction {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  walletId           String                 @db.Uuid
  amount             Decimal                @db.Decimal(20, 2)
  status             WithdrawalStatus       @default(PENDING)
  method             WithdrawalMethod       @default(MOMO)
  recipientInfo      Json
  transactionId      String                 @unique
  momoRequestId      String?
  momoTransId        String?
  requestIp          String?
  userAgent          String?
  deviceId           String?
  dailyCount         Int                    @default(1)
  weeklyAmount       Decimal                @default(0) @db.Decimal(20, 2)
  otpSentAt          DateTime?
  otpVerifiedAt      DateTime?
  processedAt        DateTime?
  completedAt        DateTime?
  expiredAt          DateTime
  errorMessage       String?
  retryCount         Int                    @default(0)
  lastRetryAt        DateTime?
  note               String?
  properties         Json?
  isActive           Boolean                @default(true)
  isDeleted          Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdBy          String?                @db.Uuid
  updatedBy          String?                @db.Uuid
  momoResults        MomoWithdrawalResult[]
  requestWithdrawals RequestWithdrawal[]
  otpTokens          WithdrawalOtp[]
  user               User                   @relation(fields: [userId], references: [id])
  wallet             UserWallet             @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@index([expiredAt])
}

model MediaFile {
  userId              String?             @db.Uuid
  id                  String              @id @default(uuid()) @db.Uuid
  fileName            String
  originalName        String?
  mimeType            String?
  sizeInBytes         BigInt?
  storagePath         String?
  url                 String?
  checksum            String?
  category            MediaFileCategory   @default(IMAGE)
  actionType          MediaFileActionType @default(UPLOAD)
  description         String?
  properties          Json?
  is_active           Boolean             @default(true)
  is_deleted          Boolean             @default(false)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  created_by          String?             @db.Uuid
  updated_by          String?             @db.Uuid
  user                User?               @relation(fields: [userId], references: [id])
  // HLS streaming    fields
  hlsPlaylistPath     String?             // Path to m3u8 playlist in MinIO
  hlsSegmentsFolder   String?             // Folder containing .ts segments
  hlsProcessingStatus String?             @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  hlsResolutions      String?             // Comma-separated: 360p,480p,720p,1080p
  hlsDuration         Int?                // Video duration in seconds
  hlsError            String?             // Error message if processing failed

  @@index([userId])
}

model Tournament {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  host_id    String             @db.Uuid
  court_id   String?            @db.Uuid
  rules      String?
  link_url   String?
  properties Json?
  time_start DateTime?
  time_end   DateTime?
  status     TournamentStatus   @default(DRAFT)
  is_active  Boolean            @default(true)
  is_deleted Boolean            @default(false)
  created_at DateTime           @default(now())
  updated_at DateTime           @default(now())
  created_by String?            @db.Uuid
  updated_by String?            @db.Uuid
  players    Player[]
  court      BadmintonCourt?    @relation(fields: [court_id], references: [id])
  host       User               @relation("UserHostedTournaments", fields: [host_id], references: [id])
  details    TournamentDetail[]
  matches    TournamentMatch[]
  teams      TournamentTeam[]
}

model Player {
  id                   String           @id @default(uuid()) @db.Uuid
  tournament_id        String           @db.Uuid
  tournament_detail_id String           @db.Uuid
  user_id              String           @db.Uuid
  team_id              String?          @db.Uuid
  is_active            Boolean          @default(true)
  is_deleted           Boolean          @default(false)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  created_by           String?          @db.Uuid
  updated_by           String?          @db.Uuid
  team                 TournamentTeam?  @relation(fields: [team_id], references: [id])
  tournament_detail    TournamentDetail @relation(fields: [tournament_detail_id], references: [id])
  tournament           Tournament       @relation(fields: [tournament_id], references: [id])
  user                 User             @relation(fields: [user_id], references: [id])

  @@unique([tournament_id, tournament_detail_id, user_id])
  @@index([user_id])
  @@index([team_id])
  @@index([tournament_detail_id])
}

model ReportOwner {
  id               String           @id @default(uuid()) @db.Uuid
  reporter_id      String           @db.Uuid
  owner_user_id   String            @db.Uuid
  booking_id       String?          @db.Uuid
  court_id         String?          @db.Uuid
  reason           String?          
  note             String?          
  properties       Json?            
  status           ReportOwnerStatus @default(PENDING)
  rating           Int?             @db.SmallInt
  is_active        Boolean          @default(true)
  is_deleted       Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now())
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid

  // relations
  reporter         User              @relation("Reporter", fields: [reporter_id], references: [id])
  owner_user       User              @relation("ReportOwnerUser", fields: [owner_user_id], references: [id])
  court            BadmintonCourt?   @relation("CourtReportOwner", fields: [court_id], references: [id])
  booking          BadmintonBooking? @relation(fields: [booking_id], references: [id])
}

model UserBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  bankId        Int?
  bankCode      String?  @db.VarChar(20)
  bankBin       String?  @db.VarChar(20)
  bankName      String
  accountNumber String
  accountName   String
  note          String?
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountNumber])
}

model Group {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  status             GroupStatus   @default(ACTIVE)
  sport_type         SportType     @default(BADMINTON)
  skill_level        String?
  city_id            String?       @db.Uuid
  city_name          String?
  district_id        String?       @db.Uuid
  district_name      String?
  manager_id         String        @db.Uuid
  avatar_url         String?
  cover_image_url    String?
  member_count       Int           @default(0)
  max_members        Int?
  is_public          Boolean       @default(true)
  require_approval   Boolean       @default(true)
  note               String?
  properties         Json?
  is_active          Boolean       @default(true)
  is_deleted         Boolean       @default(false)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @default(now())
  created_by         String?       @db.Uuid
  updated_by         String?       @db.Uuid
  
  manager            User          @relation("GroupManager", fields: [manager_id], references: [id])
  members            GroupMember[]
  posts              GroupPost[]
  bookings           BadmintonBooking[]
  
  @@index([manager_id])
  @@index([status])
  @@index([sport_type])
  @@index([city_id])
  @@index([district_id])
  @@index([is_active])
  @@index([created_at])
}

model GroupMember {
  id              String             @id @default(uuid()) @db.Uuid
  group_id        String             @db.Uuid
  user_id         String             @db.Uuid
  role            GroupMemberRole    @default(MEMBER)
  status          GroupMemberStatus  @default(PENDING)
  joined_at       DateTime?
  requested_at    DateTime           @default(now())
  approved_by     String?            @db.Uuid
  approved_at     DateTime?
  rejected_by     String?            @db.Uuid
  rejected_at     DateTime?
  rejected_reason String?
  note            String?
  properties      Json?
  is_active       Boolean            @default(true)
  is_deleted      Boolean            @default(false)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @default(now())
  created_by      String?            @db.Uuid
  updated_by      String?            @db.Uuid

  group           Group              @relation(fields: [group_id], references: [id])
  user            User               @relation("GroupMemberUser", fields: [user_id], references: [id])

  @@unique([group_id, user_id])
  @@index([group_id])
  @@index([user_id])
  @@index([status])
  @@index([role])
  @@index([created_at])
}

model GroupPost {
  id              String         @id @default(uuid()) @db.Uuid
  group_id        String         @db.Uuid
  author_id       String         @db.Uuid
  media_ids       String?        @db.Text
  content         String
  like_count      Int            @default(0)
  comment_count   Int            @default(0)
  share_count     Int            @default(0)
  status          PostStatus     @default(PENDING)
  is_active       Boolean        @default(true)
  is_deleted      Boolean        @default(false)
  note            String?
  properties      Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now())
  created_by      String?        @db.Uuid
  updated_by      String?        @db.Uuid

  group           Group          @relation(fields: [group_id], references: [id])
  author          User           @relation("GroupPostAuthor", fields: [author_id], references: [id])
  likes           PostLike[]
  comments        PostComment[]


  @@index([group_id])
  @@index([author_id])
  @@index([created_at])
}

model CourseChannel {
  id           String        @id @default(uuid()) @db.Uuid
  coach_id     String        @db.Uuid
  name         String
  description  String?
  is_active    Boolean       @default(true)
  is_deleted   Boolean       @default(false)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  created_by   String?
  updated_by   String?
  // Relations
  coach        User          @relation("CoachChannels", fields: [coach_id], references: [id])
  classes      CourseClass[]
}

model CourseEnrollment {
  id           String          @id @default(uuid()) @db.Uuid
  user_id      String          @db.Uuid
  schedule_id  String          @db.Uuid
  note         String?
  is_payment   Boolean         @default(false)
  status       PaymentStatus   @default(PENDING) 
  is_active    Boolean         @default(true)
  is_deleted   Boolean         @default(false)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  created_by   String?
  updated_by   String?

  // Relations
  schedule     CourseSchedule  @relation(fields: [schedule_id], references: [id])
  user         User            @relation(fields: [user_id], references: [id])
  orders       CourseOrder[]
}


model Feedback {
  id           String          @id @default(uuid()) @db.Uuid
  target_id    String          @db.Uuid
  type         FeedbackType
  comment      String?
  is_visible   Boolean         @default(true)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  created_by   String?         @db.Uuid
  updated_by   String?

  user         User?           @relation(fields: [created_by], references: [id])
  schedule     CourseSchedule? @relation(fields: [target_id], references: [id])
}

model PostLike {
  id         String    @id @default(uuid()) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  is_active            Boolean              @default(true)
  is_deleted           Boolean              @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  
  post       GroupPost @relation(fields: [post_id], references: [id])
  user       User      @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id]) // 1 person can only like once
}

model PostComment {
  id          String        @id @default(uuid()) @db.Uuid
  post_id     String        @db.Uuid
  user_id     String        @db.Uuid
  content     String
  parent_id   String?       @db.Uuid   // reply comment
  is_active   Boolean       @default(true)
  is_deleted  Boolean       @default(false)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now())

  post        GroupPost     @relation(fields: [post_id], references: [id])
  user        User          @relation(fields: [user_id], references: [id])
  // self relation
