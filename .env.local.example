# ============================================
# WORKFLOW SERVICE - LOCAL ENVIRONMENT
# ============================================

NODE_ENV=development
PORT=8089

DATABASE_URL=postgresql://postgres:password@localhost:5432/badminton_booking

JWT_SECRET=local-dev-secret-key-change-me

RABBITMQ_URL=amqp://guest:guest@localhost:5672

REDIS_URL=redis://localhost:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@badminton-booking.com

GATEWAY_URL=http://localhost:8080
SERVICE_NAME=workflow
SERVICE_HOST=localhost
SERVICE_PROTOCOL=http
SERVICE_BASE_URL=http://localhost:8089
SERVICE_INSTANCE_ID=workflow-local-1
GATEWAY_HEARTBEAT_INTERVAL=5000
GATEWAY_RETRY_INTERVAL=15000
GATEWAY_REGISTRY_ENABLED=true
