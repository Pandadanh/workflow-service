# ============================================
# WORKFLOW SERVICE - DEVELOPMENT ENVIRONMENT
# ============================================

NODE_ENV=development
PORT=8089

DATABASE_URL=postgresql://postgres:password@dev-db-host:5432/badminton_booking

JWT_SECRET=dev-secret-key-change-in-production

RABBITMQ_URL=amqp://guest:guest@dev-rabbitmq-host:5672

REDIS_URL=redis://dev-redis-host:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@badminton-booking.com

GATEWAY_URL=https://dev-gateway.your-domain.com
SERVICE_NAME=workflow
SERVICE_HOST=dev-workflow.your-domain.com
SERVICE_PROTOCOL=https
SERVICE_BASE_URL=https://dev-workflow.your-domain.com
SERVICE_INSTANCE_ID=workflow-dev-1
GATEWAY_HEARTBEAT_INTERVAL=5000
GATEWAY_RETRY_INTERVAL=15000
GATEWAY_REGISTRY_ENABLED=true
