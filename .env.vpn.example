NODE_ENV=development
PORT=8089

DATABASE_URL=postgresql://postgres:password@10.0.0.10:5432/badminton_booking

JWT_SECRET=vpn-secret-key-change-in-production

RABBITMQ_URL=amqp://guest:guest@10.0.0.40:5672

REDIS_URL=redis://10.0.0.20:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
